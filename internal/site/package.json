{
	"name": "vigil",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@12.9.1",
	"scripts": {
		"dev": "vite --host",
		"build": "lingui compile && vite build",
		"preview": "vite preview",
		"sync": "lingui extract --overwrite && lingui compile",
		"sync_no_compile": "lingui extract --overwrite --clean",
		"sync_and_purge": "lingui extract --overwrite --clean && lingui compile",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"typecheck": "lingui compile && tsc -b --noEmit"
	},
	"dependencies": {
		"@lingui/core": "^6.10.1",
		"@lingui/detect-locale": "^6.10.1",
		"@lingui/react": "^6.10.1",
		"@nanostores/react": "^2.0.1",
		"@nanostores/router": "^2.0.1",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-direction": "^1.2.0",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slider": "^1.6.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tabs": "^1.2.1",
		"@radix-ui/react-toast": "^1.3.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@tanstack/react-table": "^9.3.1",
		"chart.js": "^4.6.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.62.0",
		"nanostores": "^1.5.5",
		"pocketbase": "^0.28.1",
		"react": "^19.3.1",
		"react-chartjs-2": "^5.2.0",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.3.1",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@lingui/cli": "^6.10.1",
		"@lingui/format-po": "^6.10.1",
		"@lingui/swc-plugin": "^6.7.1",
		"@lingui/vite-plugin": "^6.10.1",
		"@tailwindcss/vite": "^4.1.12",
		"@types/react": "^19.1.11",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react-swc": "^4.0.1",
		"tailwindcss": "^4.1.12",
		"tw-animate-css": "^1.3.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	},
	"overrides": {
		"@nanostores/router": {
			"nanostores": "^1.3.0"
		}
	}
}
