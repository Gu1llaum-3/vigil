# Base images are pinned by immutable @sha256 digest (the tag is kept for readability) so
# builds are reproducible and a re-pointed or poisoned upstream tag cannot be pulled
# silently. To update: re-resolve with `docker buildx imagetools inspect <image:tag>
# --format '{{.Manifest.Digest}}'` (or let Dependabot's docker ecosystem bump the digests).
FROM --platform=$BUILDPLATFORM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS web-builder

WORKDIR /src/internal/site

COPY internal/site/package.json internal/site/pnpm-lock.yaml internal/site/pnpm-workspace.yaml ./
# Install the pnpm version pinned in package.json's "packageManager" field (single source of truth).
RUN npm install -g --allow-scripts=pnpm "$(node -p 'require("./package.json").packageManager')" \
	&& pnpm install --frozen-lockfile

COPY internal/site ./
RUN pnpm build

FROM --platform=$BUILDPLATFORM golang:1.27.2-alpine@sha256:85dc1069ac644ea3c527b177303a406eb3358192816cd7f9e5848eb658851673 AS builder

WORKDIR /src

ARG GOPROXY=https://proxy.golang.org,direct
ARG GOSUMDB=sum.golang.org

ENV GOPROXY=${GOPROXY}
ENV GOSUMDB=${GOSUMDB}

RUN apk add --no-cache ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . ./
COPY --from=web-builder /src/internal/site/dist ./internal/site/dist

ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
# Release version stamped into the binary (same -X flag as .goreleaser.yml). CI passes the
# git tag; a leading "v" is stripped. Local builds keep the in-source default.
ARG VERSION=""
RUN set -eu; \
	GOARM=""; \
	if [ "$TARGETARCH" = "arm" ]; then GOARM="${TARGETVARIANT#v}"; fi; \
	LDFLAGS="-w -s"; \
	if [ -n "$VERSION" ]; then LDFLAGS="$LDFLAGS -X github.com/Gu1llaum-3/vigil.Version=${VERSION#v}"; fi; \
	CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" GOARM="$GOARM" go build -ldflags "$LDFLAGS" -o /out/vigil ./internal/cmd/hub

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# iputils provides the `ping` binary used by the hub ping monitor; libcap lets us
# grant it CAP_NET_RAW so it still works when the container runs as a non-root user
# (Docker's default capability set includes NET_RAW at runtime).
RUN apk add --no-cache ca-certificates iputils libcap \
	&& setcap cap_net_raw+ep "$(command -v ping)"

# Run as an unprivileged, fixed uid/gid rather than root.
RUN addgroup -g 10001 vigil \
	&& adduser -D -u 10001 -G vigil vigil

COPY --from=builder /out/vigil /app/vigil
# License notices must travel with the binary: Vigil's (with Beszel and PocketBase) and
# THIRD_PARTY_NOTICES, which the release workflow puts in the build context. The bracket
# makes it optional, so a local build without it still works.
COPY LICENSE THIRD_PARTY_NOTICE[S] /usr/share/licenses/vigil/

# The data dir resolves to /vigil_data because the working directory is "/" and
# the hub's DefaultDataDir is the relative path "vigil_data". Do NOT add a WORKDIR
# here or that resolution (and the VOLUME below) would break.
RUN mkdir -p /vigil_data \
	&& chown -R 10001:10001 /vigil_data /app

VOLUME ["/vigil_data"]

EXPOSE 8090

USER 10001:10001

# PocketBase serves GET /api/health; busybox wget exits non-zero on any HTTP error.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD wget -qO- http://127.0.0.1:8090/api/health >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/app/vigil"]
CMD ["serve", "--http=0.0.0.0:8090"]
